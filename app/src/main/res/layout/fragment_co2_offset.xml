<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".Co2OffsetFragment">

    <!-- Kopfleiste: bleibt stehen, darunter Karte und Kennzahlen. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_co2_offset_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/btn_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_co2_offset_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/co2_offset_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_co2_offset_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Deutschland 🇩🇪" />

            <!-- Zeigt, welche Flugart in die Zahlen eingeht. Der Zeitraum steht
                 als Filter oben rechts. -->
            <TextView
                android:id="@+id/tv_co2_filter_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Flugart: Alle Flüge" />
        </LinearLayout>

        <!-- Zeitraum-Filter oben rechts: Ein Tipp öffnet das Menü, die Zahlen
             richten sich danach neu aus. Standard ist der gesamte Zeitraum. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_co2_period"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="@string/period_all_range"
            android:textColor="?attr/colorPrimary"
            android:textSize="14sp"
            app:icon="@drawable/ic_expand"
            app:iconGravity="textEnd"
            app:iconSize="18dp"
            app:iconTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Karte mit dem Wald rund um den meistgenutzten Flughafen des Abfluglands. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/co2_map_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?android:attr/colorBackground"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/ll_co2_stats"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.highfly.logbook.Co2OffsetMapView
                android:id="@+id/co2_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_co2_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="@string/co2_offset_empty"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- Spielt das Wachstum des Waldes erneut ab. -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_co2_replay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="64dp"
                android:contentDescription="@string/co2_offset_replay"
                app:fabCustomSize="44dp"
                app:maxImageSize="24dp"
                app:srcCompat="@drawable/ic_reset" />

            <!-- Holt die maßstabsgetreue Waldfläche ins Bild bzw. zurück zum Land. -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_co2_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/co2_offset_zoom_out"
                app:fabCustomSize="44dp"
                app:maxImageSize="24dp"
                app:srcCompat="@drawable/ic_zoom_out" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Kennzahlen unter der Karte: Flughafen, Emissionen, Bäume, Fläche. -->
    <LinearLayout
        android:id="@+id/ll_co2_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_co2_airport_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            tools:text="Meistgenutzter Flughafen MUC · München" />

        <TextView
            android:id="@+id/tv_co2_airport_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="8 Verbindungen · 34 Flüge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="?android:attr/colorBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tv_co2_tons_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="12,3" />

                    <TextView
                        android:id="@+id/tv_co2_tons_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/co2_offset_stat_tons_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?android:attr/colorBackground"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tv_co2_trees_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="1.234" />

                    <TextView
                        android:id="@+id/tv_co2_trees_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/co2_offset_stat_trees_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/co2_trees_bg"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/tv_co2_area_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/co2_trees_on"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="1,23" />

                    <TextView
                        android:id="@+id/tv_co2_area_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/co2_offset_stat_area_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/co2_trees_on_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_co2_legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="1 Hektar ≈ 1.000 Bäume · Waldradius ≈ 273 m" />

        <!-- Fußballfelder und (darunter) der Quellennachweis der Luftbilder.
             Der untere Abstand sitzt am Container, damit er gleich bleibt,
             egal ob der Nachweis sichtbar ist. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_co2_football"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Das entspricht ungefähr 3 Fußballfeldern" />

            <!-- Quellennachweis der amtlichen Luftbilder; nur sichtbar, wenn
                 das Merkmal in Orthophotos.ENABLED aktiv ist. -->
            <TextView
                android:id="@+id/tv_co2_attribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Luftbild: © Bayerische Vermessungsverwaltung (CC BY 4.0)"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>