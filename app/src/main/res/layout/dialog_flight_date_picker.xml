<?xml version="1.0" encoding="utf-8"?>
<!-- Kalender zum Wählen eines Datums (Ein-/Ausreise nachtragen/bearbeiten):
     oben Monat mit Vor/Zurück, darunter das Wochentags-Raster und die
     Tageszellen. Tage mit eingetragenen Flügen bekommen in der App einen
     dezenten Kreis in der Akzentfarbe, der gewählte Tag eine volle Füllung
     (wird in FlightDatePickerDialog gesetzt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cal_prev"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:rotation="180"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/cal_prev_month"
            app:icon="@drawable/ic_chevron_right"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tv_cal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            tools:text="März 2026" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cal_next"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/cal_next_month"
            app:icon="@drawable/ic_chevron_right"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/grid_cal_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:columnCount="7" />

    <GridLayout
        android:id="@+id/grid_cal_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7" />
</LinearLayout>
