<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discovery_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:contentPadding="14dp"
    app:shapeAppearanceOverlay="@style/ShapeAppearance.Logbook.Tile.Full"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Richtungspfeil mit dem Datum: bei Hin- und Rueckflug an
                     zwei Tagen steht der Hin-Pfeil vor dem Hinflug-Datum, dann
                     ein Punkt, dann der gespiegelte Rueck-Pfeil vor dem
                     Rueckflug-Datum ("12.03.2026 · 19.03.2026"); am selben Tag
                     ein Symbol mit zwei Pfeilen in Gegenrichtung vor dem einen
                     Datum. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_discovery_arrow"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_route"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_discovery_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="12.03.2026" />

                    <TextView
                        android:id="@+id/tv_discovery_date_sep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="·"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_discovery_arrow_back"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:scaleX="-1"
                        android:src="@drawable/ic_arrow_route"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_discovery_date_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:text="19.03.2026"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_discovery_aircraft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="A320 · D-ABXB"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_discovery_airline"
                android:layout_width="52dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/entry_airline_logo"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:src="@drawable/ic_airlines"
                tools:visibility="visible" />
        </LinearLayout>

        <com.highfly.logbook.RouteMiniMapView
            android:id="@+id/discovery_map"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/discovery_map" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
