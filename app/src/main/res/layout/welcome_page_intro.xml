<?xml version="1.0" encoding="utf-8"?>
<!--
    Begrüßungsseite der Willkommens-Tour: nur ein Willkommen, keine Auswahl.
    Sie steht bewusst am Anfang, damit der Nutzer erst ankommt, bevor es an
    die Einstellungen geht.

    Oben steht die Begrüßung, unten über dem Knopf der Text. Das Logo ist an
    beide gebunden (top an die Begrüßung, bottom an den Text) und über
    vertical_bias 0.5 genau in die Mitte gesetzt - es sitzt damit immer exakt
    zwischen den beiden Texten, unabhängig von der Bildschirmgröße.

    Das Logo kommt aus @mipmap/app_logo (siehe values/app_logo.xml) - dort
    ändern, wenn sich das Logo ändern soll.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/welcome_intro_logo"
        android:layout_width="144dp"
        android:layout_height="144dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toTopOf="@id/welcome_intro_body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/welcome_intro_headline"
        app:layout_constraintVertical_bias="0.5"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@mipmap/app_logo" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/welcome_intro_headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="137dp"
        android:gravity="center"
        android:text="@string/welcome_intro_headline"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/welcome_intro_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/welcome_intro_body"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/welcome_intro_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_intro_next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/welcome_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
