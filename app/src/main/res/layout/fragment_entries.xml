<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Kopfzeile der Einträge nach dem Vorbild der Länderliste: links der
         Titel (mit dem Zurückpfeil, wenn die Seite von der Karte kommt), mittig
         die Lupe, rechts der Filter. Alles steht fest über der Liste und
         scrollt nicht mit. Die drei Schaltflächen sind - wie auf der
         Länderliste - flache, transparente Icon-Buttons ohne Kachelhintergrund.
         Ein Tipp auf die Lupe schiebt das Suchfeld über den ganzen Kopf bis an
         den Filter; nur der Filter bleibt rechts sichtbar, die Lupe faehrt an
         den rechten Feldrand und wird dort zum Schliessen-X. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/entries_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/ll_entries_lead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_entries"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:backgroundTint="@android:color/transparent"
                app:contentDescription="@string/btn_back"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_entries_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entries_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Suchfeld nach dem Vorbild der Länderliste: ein schlichtes Feld ohne
             Rahmen. Beim Tippen auf die Lupe schiebt es sich von rechts über den
             ganzen Kopf bis an den Filter; der rechte Innenabstand haelt Platz
             fuer das Schliessen-X frei. -->
        <EditText
            android:id="@+id/et_entry_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="?attr/colorSurfaceContainerLow"
            android:hint="@string/entries_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:paddingVertical="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tile_entry_filter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MUC"
            tools:visibility="visible" />

        <!-- Filter, rechts in derselben Zeile - ebenfalls als flacher,
             transparenter Icon-Button. Er bleibt auch bei offener Suche
             sichtbar. Ein aktiver Filter färbt das Symbol in der Akzentfarbe
             (siehe EntriesFragment.updateFilterIcon). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tile_entry_filter"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/entries_filter_desc"
            app:icon="@drawable/ic_filter"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Lupe, mittig auf der Bildschirmbreite - wie die Lupe der
             Länderliste ein flacher, transparenter Icon-Button. Sie liegt über
             dem Suchfeld und faehrt beim Oeffnen an dessen rechten Rand. Ein
             Tipp klappt das Suchfeld auf bzw. wieder zu. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_entry_search"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/entries_search_open"
            app:icon="@drawable/ic_search"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/entries_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/entries_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/entries_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="16dp"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
