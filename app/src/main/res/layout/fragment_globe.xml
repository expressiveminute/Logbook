<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".GlobeFragment">

    <com.highfly.logbook.GlobeView
        android:id="@+id/globe_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/world_map_loading"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Zurück-Pfeil oben links. -->
    <FrameLayout
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/btn_back"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />
    </FrameLayout>

    <!-- Filter-Knopf oben rechts, darunter der Reset-Knopf (nur sichtbar,
         solange ein Filter aktiv ist) mit klarem X-Symbol. -->
    <LinearLayout
        android:id="@+id/filter_buttons"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btn_filter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btn_filter_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/world_map_filter"
                app:srcCompat="@drawable/ic_filter"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_filter_reset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/world_map_filter_reset"
                app:srcCompat="@drawable/ic_filter_reset"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <!-- Zoom-Knopfspalte rechts unten: Hineinzoomen als Plus, Herauszoomen
         als Minus, Reset als Doppelpfeil auf die Weltansicht. -->
    <LinearLayout
        android:id="@+id/map_controls"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btn_zoom_in"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/world_map_zoom_in"
                app:srcCompat="@drawable/ic_add"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_zoom_out"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/world_map_zoom_out"
                app:srcCompat="@drawable/ic_remove"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_reset"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/world_map_reset"
                app:srcCompat="@drawable/ic_zoom_out_expand"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>

        <!-- Wechselt zur 2D-Karte (immer im Querformat); dort steht der
             Knopf als „3D" und führt zurück zur Kugel. -->
        <FrameLayout
            android:id="@+id/btn_toggle_2d"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/globe_toggle_2d"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Maßband unten links, linksbündig mit dem Zurück-Pfeil (8 dp), auf
         Höhe des untersten Zoom-Knopfes rechts: folgt dem Zoom der Kugel. -->
    <com.highfly.logbook.GlobeScaleBarView
        android:id="@+id/scale_bar"
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="20dp" />

    <!-- Spuren-Knopf der Layover-Animation, links auf Höhe des
         Hineinzoomen-Knopfes (Höhe wird nach dem Layout gesetzt). -->
    <FrameLayout
        android:id="@+id/btn_layover_trails"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_icon_button"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/world_map_layover_trails"
            app:srcCompat="@drawable/ic_route_lines"
            app:tint="?attr/colorOnSurface" />
    </FrameLayout>

    <!-- Stats-Karte („x Flüge · y Routen · z Flughäfen") mittig oben, auf
         einer Ebene mit Zurück- und Filter-Knopf (oberer Rand wird in
         applyInsets an die Statusleiste gesetzt). -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="24 Flüge · 18 Routen · 14 Flughäfen" />

            <TextView
                android:id="@+id/tv_show_entries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="10dp"
                android:text="@string/world_map_show_entries"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/world_map_empty"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

</FrameLayout>
