<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".AirlineDetailFragment">

    <!-- Kopfleiste: bleibt beim Scrollen stehen, deshalb liegt sie ausserhalb
         der ScrollView. Gleiches Muster wie auf der Flughafen-Detailseite. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="?attr/colorOnSurface"
            app:iconSize="24dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/btn_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tile_airlines_singular"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_detail_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:id="@+id/detail_scroll"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="32dp">

            <!-- Kopfbereich: mittig zentriert das Logo der Airline; gibt es
                 keines, tritt an seine Stelle der Code gross - wie auf der
                 Flughafen-Detailseite. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <!-- Dekorativ: der Name der Airline steht direkt darunter. -->
                <ImageView
                    android:id="@+id/iv_airline_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:maxWidth="240dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    tools:src="@drawable/ic_airlines"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_airline_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.DisplayMedium"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="LH"
                    tools:visibility="visible" />

                <!-- Stempel rechts neben dem Logo, wenn die Airline insolvent
                     ist; schräg gedreht wie ein echter Stempel. -->
                <TextView
                    android:id="@+id/tv_airline_insolvent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_airline_insolvent_stamp"
                    android:rotation="-15"
                    android:text="@string/airline_insolvent_stamp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                    android:textColor="?attr/colorError"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Name der Airline, darunter die Codes: IATA und ICAO ohne
                 Beschriftung, dahinter das Rufzeichen in Anführungszeichen
                 (LH · DLH · "Lufthansa"). Der Name bleibt weg, wenn er den
                 Code nur wiederholt; die Code-Zeile erscheint, sobald ein Code
                 oder Rufzeichen bekannt ist. -->
            <TextView
                android:id="@+id/tv_airline_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Lufthansa"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_airline_codes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="LH · DLH · &quot;Lufthansa&quot;"
                tools:visibility="visible" />

            <!-- Foto(s) eines Fliegers in der Bemalung der Airline (Top 250,
                 Wikimedia Commons), darunter die Namensnennung. Airlines der
                 Lufthansa Group haben eine Galerie aus drei Bildern, die
                 seitlich gewischt werden; die Punkte unter dem Bild zeigen,
                 welches gerade steht. Gibt es kein Foto, bleibt die ganze
                 Kachel weg. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/airline_image_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="?android:attr/colorBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_airline_photo"
                        android:layout_width="match_parent"
                        android:layout_height="160dp" />

                    <LinearLayout
                        android:id="@+id/gallery_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_airline_photo_credit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="© Matti Blume · CC BY-SA 4.0 · Wikimedia Commons" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Allgemeine Stammdaten der Airline über der Karte - sie hängen
                 nicht vom Logbuch ab: Gründung, Insolvenz, Sitz, Hubs,
                 Flottengröße, Allianz und ein Link zur Wikipedia-Seite. Die
                 Zeilen entstehen pro Wert aus item_airport_fact.xml und
                 bleiben weg, wenn das Asset zu der Airline nichts weiß. -->
            <TextView
                android:id="@+id/tv_airline_general_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/airline_general_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/general_facts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Karte wie bei Reisebuddy: alle Strecken, die mit der Airline
                 geflogen wurden. Ein Tipp darauf öffnet die Weltkarte mit
                 voreingestelltem Airline-Filter. -->
            <TextView
                android:id="@+id/tv_airline_map_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/airline_map_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/airline_map_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="?android:attr/colorBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <com.highfly.logbook.RouteMiniMapView
                    android:id="@+id/airline_map"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:contentDescription="@string/airline_map_title" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Zahl der Flüge und Strecken, unter der Karte. -->
            <TextView
                android:id="@+id/tv_airline_map_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:visibility="gone"
                tools:text="12 Flüge auf 5 Strecken"
                tools:visibility="visible" />

            <!-- Daten aus dem eigenen Logbuch, unter der Karte: Flüge, erster
                 und letzter Flug, Ziele, Distanz, Flugzeit, Flugzeugtypen.
                 Bleibt samt Titel weg, wenn die Airline noch nicht geflogen
                 wurde. Die Zeilen entstehen pro Wert aus
                 item_airport_fact.xml. -->
            <TextView
                android:id="@+id/tv_airline_user_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/airline_user_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/user_facts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_airline_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/airline_detail_empty"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Quellennachweis der Stammdaten, klein ganz unten auf der
                 Seite; sichtbar, sobald der Abschnitt Allgemein Zeilen hat. -->
            <TextView
                android:id="@+id/tv_airline_facts_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/airline_facts_source"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
