<?xml version="1.0" encoding="utf-8"?>
<!-- Monatsueberschrift der Eintraege: Monat und Jahr stehen rechts ueber der
     ersten Kachel des Monats, alle Kacheln desselben Monats folgen direkt
     darunter. Der negative rechte Rand zieht die Schrift 1dp ueber den
     Kachelrand hinaus: der 1dp-Stroke der Karte liegt mittig auf der Kante und
     ragt 0,5dp nach aussen, dazu kommt die rechte Seitenlinie der Glyphe.
     Zusammen sassen sonst gut 1dp Luft, -1dp trifft die sichtbare Kante. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tv_entry_month"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="4dp"
    android:layout_marginEnd="-1dp"
    android:ellipsize="end"
    android:gravity="end"
    android:maxLines="1"
    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
    android:textColor="?attr/colorPrimary"
    android:textStyle="bold"
    tools:text="März 2026" />
