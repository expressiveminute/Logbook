<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".TimeCountriesFragment">

    <LinearLayout
        android:id="@+id/time_countries_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    <!-- Kopf der Seite: Titel mit Lupe rechts (blendet ein Suchfeld über den
         Titel ein) und darunter der Balken mit der Zeit im Ausland. Der
         Homebase-Hinweis steht als Fusszeile ganz unten in der Liste. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/time_countries_search_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="true">

                <TextView
                    android:id="@+id/tv_time_countries_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_countries_title"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textStyle="bold" />

                <!-- Suchfeld, das beim Tippen auf die Lupe über den Titel gleitet. -->
                <EditText
                    android:id="@+id/et_time_countries_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/colorSurfaceContainerLow"
                    android:hint="@string/time_countries_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Deu" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_time_countries_search"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                app:backgroundTint="@android:color/transparent"
                app:contentDescription="@string/time_countries_search_open"
                app:icon="@drawable/ic_search"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Balken wie auf der Rubbelkarte: Anteil der Zeit im Ausland am
             Zeitraum seit dem ersten Logbucheintrag. -->
        <LinearLayout
            android:id="@+id/time_countries_abroad_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_abroad_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/time_countries_abroad_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface" />

            <!-- Dauer mittig darüber, darunter die Leiste wie auf der
                 Layover-Detailseite (LayoverTimeBarView). -->
            <TextView
                android:id="@+id/tv_abroad_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="83 Tage · 11,9 Wochen · 2,8 Monate" />

            <com.highfly.logbook.LayoverTimeBarView
                android:id="@+id/time_abroad_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_time_countries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/time_countries_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- FAB wie auf dem Dashboard: schwebt über dem Inhalt, belegt keine eigene
         Zeile. Manueller Aufenthalt (Land + Ein-/Ausreise mit Transportmittel),
         auch wenn beide Wege nicht per Flugzeug waren. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_stay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/time_countries_add_stay_desc"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add" />
</androidx.constraintlayout.widget.ConstraintLayout>
