<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Fakten-Zeile auf der Land-Detailseite: Beschriftung links, Wert
     rechts (bei langen Werten umgebrochen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Beschriftung immer in einer Zeile (auch "Bundesstaaten/-länder"),
         notfalls gekürzt; der Wert rechts daneben läuft bei Bedarf um. -->
    <TextView
        android:id="@+id/tv_fact_label"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Hauptstadt" />

    <TextView
        android:id="@+id/tv_fact_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:maxLines="4"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:textStyle="bold"
        tools:text="Berlin" />
</LinearLayout>
