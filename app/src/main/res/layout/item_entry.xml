<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_entry_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:id="@+id/item_entry_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_edit_entry"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_entry_action_left"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/entry_action_edit"
                android:src="@drawable/ic_edit"
                app:tint="@android:color/white" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btn_delete_entry"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_entry_action_right"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/entry_action_delete"
                android:src="@drawable/ic_delete"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:contentPadding="16dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Logbook.Tile.Full"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <!-- Ein ConstraintLayout fuer die ganze Kachel. Die beiden
             Leitlinien begrenzen ein mittiges Band von 25 % bis 75 %:
             Flugroute und Reiseart sitzen darin mit gravity=center und sind
             damit exakt zur Kachel zentriert, ohne den Texten links und
             rechts ins Gehege zu kommen. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/item_band_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.25" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/item_band_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.75" />

            <!-- Zeile 1: Logo links, Flugroute mittig, Datum rechts oben. -->
            <ImageView
                android:id="@+id/iv_airline_livery"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/entry_airline_logo"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/item_route"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/item_route" />

            <TextView
                android:id="@+id/item_route"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintEnd_toStartOf="@id/item_band_end"
                app:layout_constraintStart_toStartOf="@id/item_band_start"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/item_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/item_route"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/item_route" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/item_barrier_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="iv_airline_livery,item_route,item_date" />

            <!-- Zeile 2: Airlinecode und Flugnummer links, Reiseart mittig,
                 rechts bleibt frei. -->
            <TextView
                android:id="@+id/item_flight_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/item_band_start"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_barrier_top" />

            <TextView
                android:id="@+id/item_flight_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toStartOf="@id/item_band_end"
                app:layout_constraintStart_toStartOf="@id/item_band_start"
                app:layout_constraintTop_toBottomOf="@id/item_barrier_top"
                app:layout_constraintBaseline_toBaselineOf="@id/item_flight_no" />

            <!-- Reisebuddy, nur sichtbar wenn einer hinterlegt ist. Steht rechts
                 unter dem Datum und ueber der Reiseklasse und schliesst die
                 rechte Spalte der Kachel. -->
            <ImageView
                android:id="@+id/iv_travel_buddy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/entry_travel_buddy_desc"
                android:src="@drawable/ic_reisebuddy"
                android:visibility="gone"
                app:tint="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="@id/item_flight_no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/item_flight_no" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/item_barrier_middle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="item_flight_no,item_flight_type,iv_travel_buddy" />

            <!-- Zeile 3: Flugmuster und Registrierung links, Reiseklasse
                 rechts unten. -->
            <TextView
                android:id="@+id/item_type_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toStartOf="@id/item_class"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_barrier_middle" />

            <TextView
                android:id="@+id/item_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_barrier_middle" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/item_barrier_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="item_type_meta,item_class" />

            <!-- Zeile 4: Kommentar, nur sichtbar wenn vorhanden. -->
            <TextView
                android:id="@+id/item_comment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_barrier_bottom" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>