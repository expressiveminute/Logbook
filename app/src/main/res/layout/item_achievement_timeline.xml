<?xml version="1.0" encoding="utf-8"?>
<!-- Zeile des Erfolgs-Zeitstrahls: links der Punkt mit dem Icon des Erfolgs,
     rechts Titel, Flugstrecke und darunter Datum und Flugnummer des auslösenden
     Flugs. Die ganze Zeile ist antippbar und öffnet den Eintrag zum
     Bearbeiten, deshalb der Druckeffekt als foreground. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iv_achievement_dot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_timeline_dot"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorOnPrimary"
        tools:src="@drawable/ic_flight" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_achievement_dot"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_achievement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textStyle="bold"
            tools:text="10. Flug" />

        <TextView
            android:id="@+id/tv_achievement_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="FRA → JFK" />

        <TextView
            android:id="@+id/tv_achievement_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="12.03.2024 · LH 400" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
