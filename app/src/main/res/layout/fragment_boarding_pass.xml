<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".BoardingPassFragment">

    <!-- Kein Header: Die Seite fängt gleich oben an (Statusleiste wird per
         Inset als Padding gesetzt). -->
    <ScrollView
        android:id="@+id/boarding_pass_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Die Bordkarte selbst: Hintergrundfarbe (Primärfarbe des Schemas,
             bei LH die Akzentfarbe) und Textfarbe setzt der Fragment-Code. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pass_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Zeile 1 + 2: Logo (weißer Kreis) und Flugnummer links,
                     das Datum direkt darunter (bündig zur Flugnummer, gleiche
                     Schriftgröße fett). Rechts bündig: die Reiseart-Kachel auf
                     mittiger Höhe der Flugnummer, die Funktion auf mittiger
                     Höhe des Datums - beide in derselben Schriftgröße (30 sp)
                     wie Flugnummer und Datum. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <FrameLayout
                        android:id="@+id/logo_circle"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_boarding_pass_logo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/iv_airline_logo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/boarding_pass_logo_desc"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_flight_no"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/logo_circle"
                        app:layout_constraintEnd_toStartOf="@id/tv_type_chip"
                        app:layout_constraintStart_toEndOf="@id/logo_circle"
                        app:layout_constraintTop_toTopOf="@id/logo_circle"
                        tools:text="LH 2058" />

                    <TextView
                        android:id="@+id/tv_type_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:minHeight="40dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/tv_flight_no"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_flight_no"
                        tools:background="#FF888888"
                        tools:text="On Duty"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="68dp"
                        android:layout_marginTop="2dp"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_flight_no"
                        tools:text="04.11.2026" />

                    <TextView
                        android:id="@+id/tv_extra_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:minHeight="40dp"
                        android:paddingHorizontal="10dp"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/tv_date"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_date"
                        tools:background="#FF888888"
                        tools:text="P1"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- QR-Code zum Teilen des Flugs: quadratisches weißes Feld
                     links, rechte Kante des weißen Rands in der Bildschirmmitte
                     (quadratisch, Größe setzt der Fragment-Code); rechts daneben
                     oben die Reiseklasse mit dem Sitzplatz in einer eigenen
                     Kachel dahinter, darunter die Strecke groß und fett.
                     Der Code enthält alle Daten der Bordkarte außer den
                     Reisebuddies. Abstand zur Karte darunter ist genauso groß
                     wie der zum Datum. -->
                <LinearLayout
                    android:id="@+id/row_qr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/qr_frame"
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:background="@drawable/bg_boarding_pass_qr">

                        <ImageView
                            android:id="@+id/iv_qr_code"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/boarding_pass_qr_desc"
                            android:padding="8dp"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/qr_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Reiseklasse und dahinter der Sitzplatz, je eine
                             eigene Kachel im gleichen Stil. -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_class_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:minWidth="40dp"
                                android:paddingHorizontal="10dp"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:background="#FF888888"
                                tools:text="Y"
                                tools:visibility="visible" />

                            <TextView
                                android:id="@+id/tv_seat_chip"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginStart="8dp"
                                android:gravity="center"
                                android:minWidth="40dp"
                                android:paddingHorizontal="10dp"
                                android:textColor="@android:color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:background="#FF888888"
                                tools:text="12A"
                                tools:visibility="visible" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_route"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            tools:text="MUC - ZRH" />

                        <TextView
                            android:id="@+id/tv_buddies"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textSize="16sp"
                            android:visibility="gone"
                            tools:text="Anna, Ben"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Karte mit der Flugstrecke: Der Flieger zeichnet die Linie
                     vom Start- zum Zielcode, der Zielcode erscheint erst kurz
                     vor der Ankunft. -->
                <com.highfly.logbook.RouteMiniMapView
                    android:id="@+id/route_map"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="16dp" />

                <!-- Layover: animierte Uhr + Satz, nur wenn eine Dauer
                     hinterlegt ist. -->
                <LinearLayout
                    android:id="@+id/row_layover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.highfly.logbook.LayoverClockView
                        android:id="@+id/layover_clock"
                        android:layout_width="36dp"
                        android:layout_height="36dp" />

                    <TextView
                        android:id="@+id/tv_layover_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="In JFK für 8 Stunden im Layover verbracht" />
                </LinearLayout>

                <!-- Distanz links, Flugzeit rechts. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_distance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="1.394 km" />

                    <TextView
                        android:id="@+id/tv_flight_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="1 h 25 min" />
                </LinearLayout>

                <!-- Flugzeugmuster links, Registrierung rechts. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_aircraft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Airbus A320" />

                    <TextView
                        android:id="@+id/tv_registration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="D-AIPA" />
                </LinearLayout>

                <!-- Kommentar in Handschrift. -->
                <TextView
                    android:id="@+id/tv_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/patrick_hand"
                    android:textSize="24sp"
                    android:visibility="gone"
                    tools:text="Schöner Flug!"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
