<?xml version="1.0" encoding="utf-8"?>
<!-- Detailseite einer einzelnen Flugstrecke: in der Kopfzeile mittig die
     Strecke, darunter die animierte Streckenkarte und die drei Kennzahlen
     (Häufigkeit, Flugzeit, Distanz) - jede mit ihrem eigenen Platz in der
     jeweiligen Rangliste. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".FlightRouteDetailFragment">

    <!-- Kopfleiste: bleibt beim Scrollen stehen, deshalb liegt sie ausserhalb
         der ScrollView. Gleiches Muster wie auf den übrigen Detailseiten. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/btn_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <!-- Die Strecke steht mittig in der Kopfzeile. Der leere Platz rechts
             gleicht die Breite des Zurück-Knopfes aus, damit der Titel auf dem
             Bildschirm wirklich mittig sitzt. Der Platz in der Rangliste steht
             jetzt bei jeder Kennzahl, siehe item_route_stat. -->
        <TextView
            android:id="@+id/tv_route_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textStyle="bold"
            tools:text="FRA – JFK" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flight_route_map_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <!-- Strecke als animierte Karte: das Flugzeug fliegt die Route
                 wiederholt in der tatsächlichen Richtung ab. -->
            <com.highfly.logbook.RouteMiniMapView
                android:id="@+id/route_map"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/flight_route_map_title" />

            <!-- Kennzahlen der Strecke: je Zeile ein Bild und die hochzählende
                 Zahl. Die Zeilen entstehen im Fragment aus item_route_stat. -->
            <LinearLayout
                android:id="@+id/route_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/chart_empty"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
