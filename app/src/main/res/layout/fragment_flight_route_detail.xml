<?xml version="1.0" encoding="utf-8"?>
<!-- Detailseite einer einzelnen Flugstrecke: in der Kopfzeile mittig die
     Strecke, darunter die animierte Streckenkarte und die drei Kennzahlen
     (Häufigkeit, Flugzeit, Distanz) - jede mit ihrem eigenen Platz in der
     jeweiligen Rangliste. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".FlightRouteDetailFragment">

    <!-- Kopfleiste: bleibt beim Scrollen stehen, deshalb liegt sie ausserhalb
         der ScrollView. Gleiches Muster wie auf den übrigen Detailseiten. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/btn_back"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnSurface" />

        <!-- Die Strecke steht mittig in der Kopfzeile. Der leere Platz rechts
             gleicht die Breite des Zurück-Knopfes aus, damit der Titel auf dem
             Bildschirm wirklich mittig sitzt. Der Platz in der Rangliste steht
             jetzt bei jeder Kennzahl, siehe item_route_stat. -->
        <TextView
            android:id="@+id/tv_route_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textStyle="bold"
            tools:text="FRA – JFK" />

        <!-- Platzhalter rechts, so breit wie der Zurück-Knopf. Auf der
             Reisebuddy-Detailseite weicht er einem Stift zum Umbenennen, der
             dieselbe Breite hat - der Titel bleibt dadurch mittig. -->
        <Space
            android:id="@+id/header_spacer"
            android:layout_width="48dp"
            android:layout_height="1dp" />

        <!-- Der Stift ist kleiner als der Zurück-Knopf daneben, damit er nicht
             so schwer wirkt; die Klickfläche bleibt mit 48dp gleich gross. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit"
            style="?attr/materialIconButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            app:backgroundTint="@android:color/transparent"
            app:contentDescription="@string/buddy_rename_title"
            app:icon="@drawable/ic_edit"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurface"
            tools:visibility="visible" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Nur die Flugzeugtyp-Detailseite (Hangar) zeigt diesen
                 Abschnitt über der Karte: der Anzeigename des Typs, darunter
                 ein Foto des Typs (Wikimedia Commons) samt Namensnennung und
                 darunter die allgemeinen Stammdaten (Hersteller, Baubeginn,
                 Erstauslieferung, Erstkunde, Wikipedia-Link), wie auf der
                 Airline-Detailseite. Bei einer Registrierung und den
                 anderen Nutzern dieses Layouts bleiben Name, Foto und
                 Abschnitt weg; hat das Asset zu dem Typ weder Foto noch
                 Stammdaten, bleibt alles unsichtbar. -->
            <TextView
                android:id="@+id/tv_aircraft_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Airbus A320" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/aircraft_photo_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="?android:attr/colorBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/vp_aircraft_photo"
                        android:layout_width="match_parent"
                        android:layout_height="160dp" />

                    <LinearLayout
                        android:id="@+id/aircraft_gallery_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:paddingTop="6dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_aircraft_photo_credit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="© Matti Blume · CC BY-SA 4.0 · Wikimedia Commons" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Allgemeine Stammdaten des Typs: Hersteller, Baubeginn,
                 Erstauslieferung, Erstkunde und ein Link zur Wikipedia-Seite.
                 Die Zeilen entstehen pro Wert aus item_airport_fact.xml und
                 bleiben weg, wenn das Asset zu dem Typ nichts weiß. -->
            <TextView
                android:id="@+id/tv_aircraft_general_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/airline_general_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/aircraft_facts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Quellennachweis der Stammdaten (englische Wikipedia). -->
            <TextView
                android:id="@+id/tv_aircraft_facts_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/aircraft_facts_source"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_route_map_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flight_route_map_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold" />

            <!-- Strecke als animierte Karte: das Flugzeug fliegt die Route
                 wiederholt in der tatsächlichen Richtung ab. -->
            <com.highfly.logbook.RouteMiniMapView
                android:id="@+id/route_map"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/flight_route_map_title" />

            <!-- Kennzahlen der Strecke: je Zeile ein Bild und die hochzählende
                 Zahl. Die Zeilen entstehen im Fragment aus item_route_stat und
                 stehen untereinander - jede Zeile ist so breit wie die Seite
                 (in einer horizontalen Reihe würde nur die erste Zeile Platz
                 finden und der Rest der Fläche bliebe leer). -->
            <LinearLayout
                android:id="@+id/route_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- Nur die Reisebuddy-Detailseite nutzt diese beiden Reihen: oben
                 zwei Kacheln mit dem ersten und letzten gemeinsamen Flug (im
                 Stil der Extrem-Kacheln der Layover-Seite), darunter drei
                 Kacheln mit Zahl, Zeit und Distanz der gemeinsamen Flüge. Die
                 übrigen Nutzer dieses Layouts lassen beide Reihen unsichtbar. -->
            <LinearLayout
                android:id="@+id/buddy_extremes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/buddy_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Liste aller Flüge, nur von der Flugzeug-Detailseite (Typ bzw.
                 Registrierung) gefüllt: ein Zeitstrahl nach dem Vorbild der
                 Layover-Detailseite, der jüngste Flug oben. Die anderen Nutzer
                 dieses Layouts lassen Titel und Liste unsichtbar. -->
            <TextView
                android:id="@+id/tv_flight_list_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/buddy_flight_list_title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/flight_list_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/flight_list_line"
                    android:layout_width="2dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="25dp"
                    android:background="?attr/colorPrimaryContainer" />

                <LinearLayout
                    android:id="@+id/flight_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/chart_empty"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
