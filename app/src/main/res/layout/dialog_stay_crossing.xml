<?xml version="1.0" encoding="utf-8"?>
<!-- Popup zum händischen Nachtragen von Ein-/Ausreise eines Landes (Landweg):
     oben das Datum (DatePicker), darunter das Transportmittel mit Icons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp">

    <TextView
        android:id="@+id/tv_crossing_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_crossing_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp"
        android:text="@string/time_countries_date_hint"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/stay_crossing_transport_label"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <RadioGroup
        android:id="@+id/rg_transport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_transport_car"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            app:drawableStartCompat="@drawable/ic_transport_car"
            android:text="@string/transport_car" />

        <RadioButton
            android:id="@+id/rb_transport_train"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_transport_train"
            android:text="@string/transport_train" />

        <RadioButton
            android:id="@+id/rb_transport_bus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_transport_bus"
            android:text="@string/transport_bus" />

        <RadioButton
            android:id="@+id/rb_transport_ferry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_transport_ferry"
            android:text="@string/transport_ferry" />

        <RadioButton
            android:id="@+id/rb_transport_bike"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_transport_bike"
            android:text="@string/transport_bike" />

        <RadioButton
            android:id="@+id/rb_transport_foot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:drawableStartCompat="@drawable/ic_transport_foot"
            android:text="@string/transport_foot" />
    </RadioGroup>
</LinearLayout>
