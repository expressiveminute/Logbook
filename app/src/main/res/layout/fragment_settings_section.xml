<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/settings_scroll"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".SettingsSectionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_section_back"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:backgroundTint="@android:color/transparent"
                app:contentDescription="@string/btn_back"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_settings_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
            Die Punkte sind nach Themen gruppiert: innerhalb einer Gruppe
            liegen sie mit 12 dp Abstand beieinander, zwischen zwei Gruppen
            (anderer Inhalt) mit 28 dp. Die Auswahlen laufen als Regler
            (SegmentedOptionView) wie die Reiseklasse unter "Neuer Flug".
        -->
        <LinearLayout
            android:id="@+id/content_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Thema: Rolle -->
            <LinearLayout style="@style/SettingsBlock">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/settings_role" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/role_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Nur für die Rolle Crew; bei Passagier ausgeblendet. -->
            <LinearLayout
                android:id="@+id/crew_function_group"
                style="@style/SettingsBlock"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/function_label" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/crew_function_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Thema: Standardwerte für neue Flüge -->
            <!--
                Die Fluggesellschaft gehoert beiden Rollen: Sie ist die
                Vorbefuellung fuer das Feld "Fluggesellschaft" eines neuen
                Flugs und steht deshalb zusammen mit der bevorzugten
                Arbeitsposition in dieser Gruppe.
            -->
            <!--
                Die Fluggesellschaft steht als Eingabekachel wie im Formular
                "Neuer Flug": Die Beschriftung sitzt zunächst mittig, wandert
                beim Antippen auf den oberen Rand und unterbricht dort den
                Rahmen. Den Rahmen zeichnet die Kachel selbst (InputTile),
                deshalb ist die Karte durchsichtig und trägt keinen Strich.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:contentPaddingBottom="0dp"
                app:contentPaddingEnd="0dp"
                app:contentPaddingStart="0dp"
                app:contentPaddingTop="12dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Logbook.Tile.Full"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="0dp">

                <com.highfly.logbook.InputTile
                    android:id="@+id/profile_airline_tile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="52dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:labelFor="@id/profile_airline_input"
                        android:maxLines="1"
                        android:text="@string/profile_airline_label"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/profile_airline_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="center_vertical"
                        android:hint="@string/profile_airline_hint"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:maxLength="2"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp" />
                </com.highfly.logbook.InputTile>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                style="@style/SettingsBlock"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/profile_preferred_class_label" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/preferred_class_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Thema: Hilfe -->
            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_welcome_tour" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_welcome_tour"
                        style="@style/SettingsActionButton"
                        android:text="@string/settings_welcome_tour_action" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_users"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_users_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/users_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- Die Zeilen werden zur Laufzeit aus [Users.ids] aufgebaut,
                 siehe SettingsSectionFragment.renderUsers. -->
            <LinearLayout
                android:id="@+id/content_users_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/users_add" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_user"
                        style="@style/SettingsActionButton"
                        android:text="@string/users_add_action" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_customization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Thema: Darstellung -->
            <LinearLayout style="@style/SettingsBlock">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/settings_appearance" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/theme_mode_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Die Akzentfarbe als Farbkreise in den Zellen des Reglers. -->
            <LinearLayout
                style="@style/SettingsBlock"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/settings_accent_color" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/accent_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_compact_text"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/settings_compact_text_subtitle"
                    android:text="@string/settings_compact_text" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/compact_text_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thema: Voreinstellungen -->
            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_dashboard_layout" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_dashboard"
                        style="@style/SettingsActionButton"
                        android:text="@string/dashboard_edit_action" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsBlock"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsBlockLabel"
                    android:text="@string/settings_language" />

                <com.highfly.logbook.SegmentedOptionView
                    android:id="@+id/language_selector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:labelFor="@id/default_period_dropdown"
                    android:text="@string/settings_default_period" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/default_period_layout"
                        style="@style/SettingsTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="dropdown_menu">

                        <!-- saveEnabled=false: Der Text wird bei jedem Aufbau neu
                             aus den Einstellungen gesetzt. Sonst stellt die Ansicht
                             beim Sprachwechsel ihren alten (andersprachigen) Text
                             wieder her und überschreibt die Übersetzung. -->
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/default_period_dropdown"
                            style="@style/SettingsTextField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="none"
                            android:saveEnabled="false"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:labelFor="@id/default_time_unit_dropdown"
                    android:text="@string/settings_default_time_unit" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/default_time_unit_layout"
                        style="@style/SettingsTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="dropdown_menu">

                        <!-- saveEnabled=false, siehe Standard-Zeitraum oben. -->
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/default_time_unit_dropdown"
                            style="@style/SettingsTextField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="none"
                            android:saveEnabled="false"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Thema: Daten importieren/exportieren (JSON, alle App-Daten)
                 als eine grosse Kachel im Stil der Reiseart-Kachel auf der
                 Flüge-Seite (Sekundaercontainer, 16dp Ecken, dezenter Strich):
                 oben der Titel, darunter ein kurzer Beschreibungstext und
                 unten links/rechts die beiden Knoepfe mit Symbol. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_full_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSecondaryContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="16dp">

                    <!-- Überschrift der Kachel. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/data_full_title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Kurzer Beschreibungstext, was die Datei umfasst. -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/data_full_description"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

                    <!-- Knopfzeile: Export links, Import rechts, beide mit
                         Symbol. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_full_export"
                            style="@style/SettingsActionButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/data_full_export"
                            app:icon="@drawable/ic_export"
                            app:iconGravity="textStart" />

                        <Space
                            android:layout_width="8dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_full_import"
                            style="@style/SettingsActionButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/data_full_import"
                            app:icon="@drawable/ic_import"
                            app:iconGravity="textStart" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Thema: Datenbank als CSV sichern/wiederherstellen (nur
                 Flugdatensatz, im CSV-Format) -->
            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="28dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/data_export_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export"
                        style="@style/SettingsActionButton"
                        android:text="@string/data_export" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/data_import_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_import"
                        style="@style/SettingsActionButton"
                        android:text="@string/data_import" />
                </LinearLayout>
            </LinearLayout>

            <!-- Thema: Gefahrenzone. Beide Aktionen benötigen die Passphrase
                 FLIGHTS, siehe [PassphraseConfirm]. Der Strich trennt sie
                 sichtbar von Export/Import ab, damit nichts versehentlich
                 daneben gerät. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/danger_zone_title"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorError"
                android:textStyle="bold" />

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/danger_delete_user_subtitle"
                    android:text="@string/danger_delete_user_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_delete_user"
                        style="@style/SettingsActionButton"
                        android:text="@string/danger_delete_user_action" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/SettingsRow"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/danger_reset_subtitle"
                    android:text="@string/danger_reset_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_factory_reset"
                        style="@style/SettingsActionButton"
                        android:text="@string/danger_reset_action" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_development"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/development_crash_log_subtitle"
                    android:text="@string/development_crash_log" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_crash_log"
                        style="@style/SettingsActionButton"
                        android:text="@string/development_crash_log_action" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_demo_data"
                style="@style/SettingsRow"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/development_demo_data_subtitle"
                    android:text="@string/development_demo_data" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/demo_data_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
