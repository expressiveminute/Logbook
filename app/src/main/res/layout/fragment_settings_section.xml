<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    tools:context=".SettingsSectionFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings_section_back"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:backgroundTint="@android:color/transparent"
                app:contentDescription="@string/btn_back"
                app:icon="@drawable/ic_arrow_back"
                app:iconSize="24dp"
                app:iconTint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_settings_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/settings_title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_role" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/role_crew_tile"
                        style="@style/SettingsTile"
                        android:layout_marginEnd="3dp">

                        <TextView
                            android:id="@+id/role_crew_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/role_crew" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/role_passenger_tile"
                        style="@style/SettingsTile">

                        <TextView
                            android:id="@+id/role_passenger_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/role_passenger" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/crew_function_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/function_label" />

                    <LinearLayout style="@style/SettingsRowValue">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/crew_function_purser_ii_tile"
                            style="@style/SettingsTile"
                            android:layout_marginEnd="3dp">

                            <TextView
                                android:id="@+id/crew_function_purser_ii_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/crew_function_purser_ii" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/crew_function_purser_i_tile"
                            style="@style/SettingsTile"
                            android:layout_marginEnd="3dp">

                            <TextView
                                android:id="@+id/crew_function_purser_i_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/crew_function_purser_i" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/crew_function_flight_attendant_tile"
                            style="@style/SettingsTile">

                            <TextView
                                android:id="@+id/crew_function_flight_attendant_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/crew_function_flight_attendant" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:labelFor="@id/profile_airline_input"
                        android:text="@string/profile_airline_label" />

                    <LinearLayout style="@style/SettingsRowValue">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/profile_airline_layout"
                            style="@style/SettingsTextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/profile_airline_input"
                                style="@style/SettingsTextField.EditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/profile_airline_hint"
                                android:imeOptions="actionDone"
                                android:inputType="text"
                                android:maxLength="2"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsRowLabel"
                        android:text="@string/profile_preferred_class_label" />

                    <LinearLayout style="@style/SettingsRowValue">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/preferred_class_economy_tile"
                            style="@style/SettingsTile"
                            android:layout_marginEnd="3dp">

                            <TextView
                                android:id="@+id/preferred_class_economy_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/class_economy" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/preferred_class_premium_economy_tile"
                            style="@style/SettingsTile"
                            android:layout_marginEnd="3dp">

                            <TextView
                                android:id="@+id/preferred_class_premium_economy_label"
                                style="@style/SettingsTileLabel"
                                android:contentDescription="@string/class_premium_economy"
                                android:text="@string/class_premium_economy_short" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/preferred_class_business_tile"
                            style="@style/SettingsTile"
                            android:layout_marginEnd="3dp">

                            <TextView
                                android:id="@+id/preferred_class_business_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/class_business" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/preferred_class_first_tile"
                            style="@style/SettingsTile">

                            <TextView
                                android:id="@+id/preferred_class_first_label"
                                style="@style/SettingsTileLabel"
                                android:text="@string/class_first" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_themes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_appearance" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dark_mode_tile"
                        style="@style/SettingsTile"
                        android:layout_marginEnd="3dp">

                        <TextView
                            android:id="@+id/dark_mode_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/settings_dark_mode" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/light_mode_tile"
                        style="@style/SettingsTile"
                        android:layout_marginEnd="3dp">

                        <TextView
                            android:id="@+id/light_mode_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/settings_light_mode" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/system_mode_tile"
                        style="@style/SettingsTile">

                        <TextView
                            android:id="@+id/system_mode_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/settings_system_mode" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_accent_color" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/accent_brown_tile"
                        style="@style/SettingsTile"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/settings_accent_brown" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/accent_magenta_tile"
                        style="@style/SettingsTile"
                        android:layout_marginEnd="3dp"
                        android:contentDescription="@string/settings_accent_magenta" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/accent_turquoise_tile"
                        style="@style/SettingsTile"
                        android:contentDescription="@string/settings_accent_turquoise" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_customization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/settings_language" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/lang_de_tile"
                        style="@style/SettingsTile">

                        <TextView
                            android:id="@+id/lang_de_label"
                            style="@style/SettingsTileLabel"
                            android:text="@string/settings_lang_de" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:labelFor="@id/default_period_dropdown"
                    android:text="@string/settings_default_period" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/default_period_layout"
                        style="@style/SettingsTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/default_period_dropdown"
                            style="@style/SettingsTextField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="none"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:labelFor="@id/default_time_unit_dropdown"
                    android:text="@string/settings_default_time_unit" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/default_time_unit_layout"
                        style="@style/SettingsTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/default_time_unit_dropdown"
                            style="@style/SettingsTextField.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="none"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_compact_text"
                style="@style/SettingsRow"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/settings_compact_text_subtitle"
                    android:text="@string/settings_compact_text" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/compact_text_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/data_export_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_export"
                        style="@style/SettingsActionButton"
                        android:text="@string/data_export" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:text="@string/data_import_label" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_import"
                        style="@style/SettingsActionButton"
                        android:text="@string/data_import" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_development"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/SettingsRow">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/development_crash_log_subtitle"
                    android:text="@string/development_crash_log" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_crash_log"
                        style="@style/SettingsActionButton"
                        android:text="@string/development_crash_log_action" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_demo_data"
                style="@style/SettingsRow"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    style="@style/SettingsRowLabel"
                    android:contentDescription="@string/development_demo_data_subtitle"
                    android:text="@string/development_demo_data" />

                <LinearLayout style="@style/SettingsRowValue">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/demo_data_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
