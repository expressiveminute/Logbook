<?xml version="1.0" encoding="utf-8"?>
<!--
    Eine Zeile im Filtermenue ueber den Kacheln. Der Haken steht rechts und
    markiert die aktuelle Auswahl, damit nach dem Tippen klar ist, was gerade
    die Kacheln bestimmt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_popup_item"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tv_filter_popup_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <ImageView
        android:id="@+id/iv_filter_popup_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/dashboard_filter_selected"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="?attr/colorPrimary" />
</LinearLayout>