<?xml version="1.0" encoding="utf-8"?>
<!-- Rahmen des Insolvenz-Stempels auf der Airline-Detailseite: rote Umrandung
     ohne Füllung, damit das Logo dahinter lesbar bleibt. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.5dp"
        android:color="?attr/colorError" />
    <corners android:radius="4dp" />
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />
</shape>
