<?xml version="1.0" encoding="utf-8"?>
<!-- Quadratischer weißer Hintergrund des QR-Codes auf der Bordkarte: Weiß,
     damit der Code auf jeder Kartenfarbe (auch LH-Gold) scannbar bleibt. -->
