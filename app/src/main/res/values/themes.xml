<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Logbook" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.Logbook" parent="Base.Theme.Logbook">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
    </style>

    <style name="Theme.Logbook.LightBlue" parent="Theme.Logbook">
        <item name="colorPrimary">@color/accent_lightblue_primary</item>
        <item name="colorOnPrimary">@color/accent_lightblue_on_primary</item>
        <item name="colorPrimaryContainer">@color/accent_lightblue_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/accent_lightblue_on_primary_container</item>
        <item name="colorSecondary">@color/accent_lightblue_secondary</item>
        <item name="colorOnSecondary">@color/accent_lightblue_on_secondary</item>
        <item name="colorSecondaryContainer">@color/accent_lightblue_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/accent_lightblue_on_secondary_container</item>
        <item name="colorTertiary">@color/accent_lightblue_tertiary</item>
        <item name="colorOnTertiary">@color/accent_lightblue_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/accent_lightblue_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/accent_lightblue_on_tertiary_container</item>
    </style>

    <style name="Theme.Logbook.LightGreen" parent="Theme.Logbook">
        <item name="colorPrimary">@color/accent_lightgreen_primary</item>
