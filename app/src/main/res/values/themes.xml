        <item name="colorOnSecondaryContainer">@color/accent_lightgreen_on_secondary_container</item>
        <item name="colorTertiary">@color/accent_lightgreen_tertiary</item>
        <item name="colorOnTertiary">@color/accent_lightgreen_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/accent_lightgreen_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/accent_lightgreen_on_tertiary_container</item>
