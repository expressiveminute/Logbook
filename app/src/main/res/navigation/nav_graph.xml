<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.highfly.logbook.FirstFragment"
        tools:layout="@layout/fragment_first">

        <action
            android:id="@+id/action_dashboard_to_add_entry"
            app:destination="@id/nav_add_entry" />
        <action
            android:id="@+id/action_dashboard_to_tile_detail"
            app:destination="@id/nav_tile_detail" />
        <action
            android:id="@+id/action_dashboard_to_world_map"
            app:destination="@id/nav_world_map" />
        <action
            android:id="@+id/action_dashboard_to_flights_year"
            app:destination="@id/nav_flights_year" />
        <action
            android:id="@+id/action_dashboard_to_time_detail"
            app:destination="@id/nav_time_detail" />
        <action
            android:id="@+id/action_dashboard_to_distance_detail"
            app:destination="@id/nav_distance_detail" />
        <action
            android:id="@+id/action_dashboard_to_travel_buddies"
            app:destination="@id/nav_travel_buddies" />
        <action
            android:id="@+id/action_dashboard_to_visited_countries"
            app:destination="@id/nav_visited_countries" />
        <action
            android:id="@+id/action_dashboard_to_co2_offset"
            app:destination="@id/nav_co2_offset" />
        <action
            android:id="@+id/action_dashboard_to_achievements"
            app:destination="@id/nav_achievements" />
    </fragment>

    <fragment
        android:id="@+id/nav_entries"
        android:name="com.highfly.logbook.EntriesFragment"
        tools:layout="@layout/fragment_entries">

        <argument
            android:name="airportFilter"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_entries_to_add_entry"
            app:destination="@id/nav_add_entry" />
    </fragment>

    <fragment
        android:id="@+id/nav_rubbelkarte"
        android:name="com.highfly.logbook.RubbelkarteFragment"
        tools:layout="@layout/fragment_rubbelkarte">

        <action
            android:id="@+id/action_rubbelkarte_to_countries"
            app:destination="@id/nav_countries" />
    </fragment>

    <fragment
        android:id="@+id/nav_countries"
        android:name="com.highfly.logbook.CountriesFragment"
        tools:layout="@layout/fragment_countries">

        <!-- Leer zeigt alle Länder der Welt, gesetzt nur die eines Kontinents:
             Die Kacheln der Rubbelkarte öffnen dieselbe Seite gefiltert. -->
        <argument
            android:name="continent"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Länderliste des Dashboards: alle besuchten Länder, ein Tipp führt zur
         Länderseite mit der Karte. -->
    <fragment
        android:id="@+id/nav_visited_countries"
        android:name="com.highfly.logbook.VisitedCountriesFragment"
        tools:layout="@layout/fragment_visited_countries">

        <action
            android:id="@+id/action_visited_countries_to_country_detail"
            app:destination="@id/nav_country_detail" />
    </fragment>

    <!-- Länderseite: Karte des Landes mit angeflogenen Flughäfen und den
         Verbindungen aus dem Logbuch. -->
    <fragment
        android:id="@+id/nav_country_detail"
        android:name="com.highfly.logbook.CountryDetailFragment"
        tools:layout="@layout/fragment_country_detail">

        <argument
            android:name="iso2"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.highfly.logbook.ProfileFragment"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profile_to_settings_section"
            app:destination="@id/nav_settings_section"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/nav_settings_section"
        android:name="com.highfly.logbook.SettingsSectionFragment"
        tools:layout="@layout/fragment_settings_section">

        <argument
            android:name="sectionKey"
            app:argType="string"
            android:defaultValue="profile" />

        <action
            android:id="@+id/action_settings_section_to_import"
            app:destination="@id/nav_import" />
        <action
            android:id="@+id/action_settings_section_to_dashboard_edit"
            app:destination="@id/nav_dashboard_edit" />
    </fragment>

    <fragment
        android:id="@+id/nav_dashboard_edit"
        android:name="com.highfly.logbook.DashboardEditFragment"
        tools:layout="@layout/fragment_dashboard_edit" />

    <fragment
        android:id="@+id/nav_import"
        android:name="com.highfly.logbook.ImportFragment"
        tools:layout="@layout/fragment_import" />

    <fragment
        android:id="@+id/nav_add_entry"
        android:name="com.highfly.logbook.AddEntryFragment"
        tools:layout="@layout/fragment_add_entry">

        <argument
            android:name="entryId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/nav_tile_detail"
        android:name="com.highfly.logbook.TileDetailFragment"
        tools:layout="@layout/fragment_tile_detail">

        <argument
            android:name="tileId"
            app:argType="string"
            android:defaultValue="flights" />

        <action
            android:id="@+id/action_tile_detail_to_layover_detail"
            app:destination="@id/nav_layover_detail" />
        <action
            android:id="@+id/action_tile_detail_to_airport_detail"
            app:destination="@id/nav_airport_detail" />
        <action
            android:id="@+id/action_tile_detail_to_flight_route_detail"
            app:destination="@id/nav_flight_route_detail" />
        <action
            android:id="@+id/action_tile_detail_to_aircraft_flights"
            app:destination="@id/nav_aircraft_flights" />
    </fragment>

    <fragment
        android:id="@+id/nav_aircraft_flights"
        android:name="com.highfly.logbook.AircraftFlightsFragment"
        tools:layout="@layout/fragment_flight_route_detail">

        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="type" />

        <argument
            android:name="value"
            app:argType="string"
            android:defaultValue="" />

        <!-- Flug der Liste antippen: direkt zur Seite "Flug bearbeiten". -->
        <action
            android:id="@+id/action_aircraft_flights_to_add_entry"
            app:destination="@id/nav_add_entry" />
    </fragment>

    <fragment
        android:id="@+id/nav_layover_detail"
        android:name="com.highfly.logbook.LayoverDetailFragment"
        tools:layout="@layout/fragment_layover_detail">

        <argument
            android:name="code"
            app:argType="string"
            android:defaultValue="" />

        <!-- Eintrag des Zeitstrahls antippen: direkt zur Seite "Flug bearbeiten". -->
        <action
            android:id="@+id/action_layover_detail_to_add_entry"
            app:destination="@id/nav_add_entry" />
    </fragment>

    <!-- Detailseite eines Flughafens aus der Kachel "Flughäfen": Kenndaten
         und Kartenausschnitt des Landes mit Marker. -->
    <fragment
        android:id="@+id/nav_airport_detail"
        android:name="com.highfly.logbook.AirportDetailFragment"
        tools:layout="@layout/fragment_airport_detail">

        <argument
            android:name="code"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Detailseite einer einzelnen Flugstrecke aus der Kachel "Flugrouten":
         Kopfzeile mit der Strecke, animierte Streckenkarte und die Kennzahlen
         (Häufigkeit, Flugzeit, Distanz), jede mit ihrem eigenen Rang. -->
    <fragment
        android:id="@+id/nav_flight_route_detail"
        android:name="com.highfly.logbook.FlightRouteDetailFragment"
        tools:layout="@layout/fragment_flight_route_detail">

        <argument
            android:name="route"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_flights_year"
        android:name="com.highfly.logbook.FlightsYearFragment"
        tools:layout="@layout/fragment_flights_year">

        <action
            android:id="@+id/action_flights_year_to_months"
            app:destination="@id/nav_flights_months" />
    </fragment>

    <fragment
        android:id="@+id/nav_flights_months"
        android:name="com.highfly.logbook.FlightsMonthsFragment"
        tools:layout="@layout/fragment_flights_months">

        <argument
            android:name="year"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <fragment
        android:id="@+id/nav_world_map"
        android:name="com.highfly.logbook.WorldMapFragment"
        tools:layout="@layout/fragment_world_map">

        <action
            android:id="@+id/action_world_map_to_entries"
            app:destination="@id/nav_entries" />
    </fragment>

    <fragment
        android:id="@+id/nav_discovery"
        android:name="com.highfly.logbook.DiscoveryFragment"
        tools:layout="@layout/fragment_discovery" />

    <fragment
        android:id="@+id/nav_time_detail"
        android:name="com.highfly.logbook.TimeDetailFragment"
        tools:layout="@layout/fragment_time_detail" />

    <!-- Detailseite der Kachel "Distanz": animierte Strecken des längsten und
         kürzesten Flugs sowie Erdumrundungen, Mond- und Sonnenweg. -->
    <fragment
        android:id="@+id/nav_distance_detail"
        android:name="com.highfly.logbook.DistanceDetailFragment"
        tools:layout="@layout/fragment_distance_detail" />

    <fragment
        android:id="@+id/nav_travel_buddies"
        android:name="com.highfly.logbook.TravelBuddyFragment"
        tools:layout="@layout/fragment_travel_buddies" >

        <action
            android:id="@+id/action_travel_buddies_to_detail"
            app:destination="@id/nav_travel_buddy_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_travel_buddy_detail"
        android:name="com.highfly.logbook.TravelBuddyDetailFragment"
        tools:layout="@layout/fragment_flight_route_detail">

        <argument
            android:name="name"
            app:argType="string"
            android:defaultValue="" />
        
        <action
            android:id="@+id/action_buddy_detail_to_world_map"
            app:destination="@id/nav_world_map" />
        
        <action
            android:id="@+id/action_buddy_detail_to_add_entry"
            app:destination="@id/nav_add_entry" />
    </fragment>

    <!-- Seite "CO₂-Ausgleich": Karte des Abfluglands mit dem meistgenutzten
         Flughafen und dem animierten Wald. Sie öffnet die CO₂-Kachel des
         Dashboards. -->
    <fragment
        android:id="@+id/nav_co2_offset"
        android:name="com.highfly.logbook.Co2OffsetFragment"
        tools:layout="@layout/fragment_co2_offset" />

    <!-- Seite "Achievements": Fortschritt und Zeitstrahl der erreichten Erfolge.
         Die hervorgehobene Kachel öffnet die Übersicht aller Erfolge, eine
         Zeile des Zeitstrahls den Eintrag zum Bearbeiten. -->
    <fragment
        android:id="@+id/nav_achievements"
        android:name="com.highfly.logbook.AchievementsFragment"
        tools:layout="@layout/fragment_achievements">

        <action
            android:id="@+id/action_achievements_to_grid"
            app:destination="@id/nav_achievements_grid" />
        <action
            android:id="@+id/action_achievements_to_add_entry"
            app:destination="@id/nav_add_entry" />
    </fragment>

    <!-- Übersicht aller Erfolge, nach Kategorie. -->
    <fragment
        android:id="@+id/nav_achievements_grid"
        android:name="com.highfly.logbook.AchievementsGridFragment"
        tools:layout="@layout/fragment_achievements_grid" />
</navigation>
